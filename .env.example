# Copy to .env and fill in. Never commit .env.

# Long random string used to sign login tokens.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database. SQLite by default; use PostgreSQL in production (postgres:// and postgresql:// URLs both work).
DATABASE_URL=sqlite:///./database/talentai.db
# DATABASE_URL=postgresql://talentai:change-me@localhost:5432/talentai
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# The API applies pending migrations on startup. Set to false to run `alembic upgrade head` yourself.
# AUTO_MIGRATE=true

# Rate limiting (per client IP)
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_DEFAULT=120/minute
# RATE_LIMIT_AUTH=10/minute
# RATE_LIMIT_HEAVY=20/minute
# Use Redis when running more than one worker so limits are shared: RATE_LIMIT_STORAGE_URI=redis://localhost:6379
# Set to true only behind a reverse proxy you control, so the real client IP is read from X-Forwarded-For.
# TRUST_PROXY=false

# AI features (resume scoring + interview questions). Get a key at https://console.groq.com
# Without a valid key the app still works and falls back to keyword matching.
GROQ_API_KEY=

# Browser origins allowed to call the API (comma separated). Defaults cover local development.
# CORS_ORIGINS=https://hr.yourcompany.com

# Candidate emails: sent automatically when onboarding starts (accepted), completes (welcome) or is rejected.
# Leave SMTP_HOST empty to keep email off; attempts are then logged as "skipped" and can be re-sent later.
# Gmail: smtp.gmail.com / 587 / an App Password (not your normal password). Other providers: use their SMTP details.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=hr@yourcompany.com
# SMTP_PASSWORD=
# SMTP_FROM=YourCompany Recruiting <hr@yourcompany.com>
# EMAIL_REPLY_TO=
# COMPANY_NAME=YourCompany
# AUTO_EMAIL=true
